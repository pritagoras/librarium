{
  "name": "librarium",
  "version": "1.0.0",
  "private": true,
  "description": "Tu biblioteca personal y cuaderno de lectura",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "build": "vite build && node scripts/copy-build-assets.mjs",
    "lint": "tsc --noEmit && eslint firestore.rules",
    "test": "tsx --test tests/notes-and-backup.test.ts tests/sync-merge.test.ts tests/characters.test.ts"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/express": "^5.0.6",
    "eslint": "^10.15.0",
    "express": "^4.21.2",
    "firebase": "^13.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
